<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Acceso administrador | PASION RL BIKERS</title><link rel="stylesheet" href="/css/styles.css"></head><body class="login-page">
<div class="login-card"><a class="back-link" href="/">← Volver al sitio</a><p class="eyebrow">ZONA PRIVADA</p><h1>Panel de <span>administración</span></h1><p class="muted">Ingresa con tus credenciales para gestionar los miembros.</p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="/admin/login"><label>Usuario<input name="username" autocomplete="username" required></label><label>Contraseña<input type="password" name="password" autocomplete="current-password" required></label><button class="btn btn-primary full" type="submit">Iniciar sesión</button></form></div></body></html>
